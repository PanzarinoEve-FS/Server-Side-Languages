{
  "info": {
    "name": "Users API",
    "description": "The 5 methods for the users context, plus the actuator at localhost:3000. Run POST before the by-ID requests: it saves the new user's ID in the userId variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userId", "value": "1" }
  ],
  "item": [
    {
      "name": "Actuator - Service is up",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Message is Service is up\", () => pm.expect(pm.response.json().message).to.eql(\"Service is up\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET all users",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST create user",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"email\": \"ada@example.com\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
              "// Save the new user's ID so the by-ID requests below use it.",
              "pm.collectionVariables.set(\"userId\", pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET user by ID",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Output shows the ID\", () => pm.expect(pm.response.json().id).to.eql(String(pm.collectionVariables.get(\"userId\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT update user by ID",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ada King\",\n  \"email\": \"ada@example.com\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Output shows the ID\", () => pm.expect(pm.response.json().id).to.eql(String(pm.collectionVariables.get(\"userId\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE user by ID",
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Output shows the ID\", () => pm.expect(pm.response.json().id).to.eql(String(pm.collectionVariables.get(\"userId\"))));"
            ]
          }
        }
      ]
    }
  ]
}
